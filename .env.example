# Copy to .env to change anything. Every value has a working local default,
# so `docker compose up --build` runs without this file.

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=8081
POSTGRES_PORT=5433

# Local-only credentials. Use your own strong values for any real deployment.
POSTGRES_PASSWORD=canteen_dev_only
JWT_SECRET=dev-only-jwt-secret-not-for-any-real-deployment
PICKUP_SECRET=dev-only-pickup-secret-not-for-any-real-deployment

# sandbox: simulated payments, no account needed. razorpay: real test mode.
PAYMENT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo accounts and past orders, plus the role buttons on the login page.
SEED_DEMO_DATA=true
VITE_DEMO_MODE=true

# Logins allowed per account per minute. Raise only for automated test runs.
LOGIN_LIMIT_PER_EMAIL=10

# Orders per 15-minute pickup slot.
SLOT_CAPACITY=10

# Origins the API accepts, comma-separated. Add a tunnel URL (for example from ngrok)
# to test the camera on a real phone over HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
